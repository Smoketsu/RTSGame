<?xml version="1.0" encoding="utf-8"?>
<!-- NuGet.config: package sources for every .NET project in the repository. Names nuget.org explicitly so restore works with SDKs that ship without a default feed, such as the .NET 8 SDK bundled with the Unity editor. -->
<configuration>
  <packageSources>
    <!-- The public NuGet feed; the only source the projects use (NUnit, the test adapter and the test SDK). -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
