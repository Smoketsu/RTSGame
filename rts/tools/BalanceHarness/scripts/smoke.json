// rts/tools/BalanceHarness/scripts/smoke.json: Phase 0 smoke script for the headless harness. Skai versus Water on the grey-box map: each player spawns three units, several moves are issued at different ticks, one unit is removed, and the harness prints the state hashes. CI runs it twice and requires identical STATE_HASH lines (determinism check).
{
  "$schema_version": 1,
  "$doc": "Smoke script: two players, six spawns, six moves, one removal, one no-op, 600 ticks (30 seconds) with seed 1234; used by CI to prove the headless run is deterministic.",
  // Seed for the simulation's one random number generator. Unit: unsigned integer. Range: 0 to 18446744073709551615. Source: docs/decisions/ADR-005-state-hash.md (same seed and commands give the same hash).
  "seed": 1234,
  // How many ticks to simulate. Unit: ticks (20 per second, so 600 is 30 seconds). Range: 0 to 1000000. Source: docs/decisions/ADR-004-tick-rate.md.
  "ticks": 600,
  // Player slots. id: slot 0 to 254; team: 0 to 254 (different teams are enemies); faction: an ID from rts/data/factions; name: display text. Source: Game modes (any player count, teams explicit).
  "players": [
    { "id": 0, "team": 0, "faction": "skai", "name": "Skai player" },
    { "id": 1, "team": 1, "faction": "water", "name": "Water player" }
  ],
  // Commands. tick: tick the command is applied on (0 to 1000000); issuer: player slot, or 255 for the script itself; sequence: per-issuer counter, unique per issuer (0 or more); type: noop, spawn_unit, move_unit or remove_unit. x and y: tiles from the map origin, decimal text or a number. Entity IDs are handed out in application order starting at 1: tick 0 applies issuer 0 first, so Skai units are 1 to 3 and Water units are 4 to 6. Source: Phase 0 command set (rts/src/Sim/Commands/CoreCommands.cs).
  "commands": [
    // Tick 0: Skai spawns near its start point (8, 8).
    { "tick": 0, "issuer": 0, "sequence": 0, "type": "spawn_unit", "definition": "skai.fledgling", "owner": 0, "x": "8", "y": "8" },
    { "tick": 0, "issuer": 0, "sequence": 1, "type": "spawn_unit", "definition": "skai.windrunner", "owner": 0, "x": "9", "y": "8" },
    { "tick": 0, "issuer": 0, "sequence": 2, "type": "spawn_unit", "definition": "skai.roc_rider", "owner": 0, "x": "10", "y": "8" },
    // Tick 0: Water spawns near its start point (56, 56).
    { "tick": 0, "issuer": 1, "sequence": 0, "type": "spawn_unit", "definition": "water.tender", "owner": 1, "x": "56", "y": "56" },
    { "tick": 0, "issuer": 1, "sequence": 1, "type": "spawn_unit", "definition": "water.spoutling", "owner": 1, "x": "55", "y": "56" },
    { "tick": 0, "issuer": 1, "sequence": 2, "type": "spawn_unit", "definition": "water.grasper", "owner": 1, "x": "54", "y": "56" },
    // Tick 20: the Windrunner (unit 2) raids toward the middle of the map.
    { "tick": 20, "issuer": 0, "sequence": 3, "type": "move_unit", "unit": 2, "x": "40", "y": "20.5" },
    // Tick 40: the Spoutling (unit 5) moves out to meet it, to a fractional target.
    { "tick": 40, "issuer": 1, "sequence": 3, "type": "move_unit", "unit": 5, "x": "30.25", "y": "40.75" },
    // Tick 60: the Roc Rider (unit 3) flies a long diagonal.
    { "tick": 60, "issuer": 0, "sequence": 4, "type": "move_unit", "unit": 3, "x": 50, "y": 50 },
    // Tick 100: the Grasper (unit 6) advances; the script (issuer 255) moves the Tender (unit 4) to show scripted orders.
    { "tick": 100, "issuer": 1, "sequence": 4, "type": "move_unit", "unit": 6, "x": "20", "y": "20" },
    { "tick": 100, "issuer": 255, "sequence": 0, "type": "move_unit", "unit": 4, "x": "60", "y": "40" },
    // Tick 150: a no-op from the script, as a network keep-alive stand-in.
    { "tick": 150, "issuer": 255, "sequence": 1, "type": "noop" },
    // Tick 200: the Windrunner pulls back to its start (strike, retreat, strike again).
    { "tick": 200, "issuer": 0, "sequence": 5, "type": "move_unit", "unit": 2, "x": "9", "y": "8" },
    // Tick 300: Water removes its Tender (unit 4).
    { "tick": 300, "issuer": 1, "sequence": 5, "type": "remove_unit", "unit": 4 },
    // Tick 350: the Fledgling (unit 1) walks to the middle of the map.
    { "tick": 350, "issuer": 0, "sequence": 6, "type": "move_unit", "unit": 1, "x": "32", "y": "32" }
  ]
}
