        "death": {"frames": 36, "loop": false, "channels": {
          "root": {"keys": [[1, [0, 0, 0], [0, 0, 0]], [8, [0, -6, 0], [0, 0.02, 0]], [22, [0, 55, 0], [0, 0, 0.26]], [30, [0, 86, 0], [0, 0, 0.38]], [36, [0, 84, 0], [0, 0, 0.38]]]},
