// rts/tools/Models3D/rig_data.json: per-unit rig tables read by rig.py: joint (bone) positions in normalised model space and the keyframed actions. Part of the model pipeline (rts/tools/Models3D); not read by the game.
// Lines starting with // are comments; rig.py strips them before parsing, so everything else is plain JSON.
//
// Coordinates: the normalised model space of convert_static.py, in footprint units (longest footprint side = 1.0), Blender axes:
// +X = the model's left, -Y = the model's front (forward), +Z = up, ground at z = 0, footprint centred on x = y = 0.
// A bone is "head" (start, joint position) to "tail" (end); bones named *_l are on +X, *_r on -X.
// Rotation values are degrees about the three armature-space axes (applied X, then Y, then Z) in the REST pose frame of the parent:
//   +rx swings a hanging limb toward +Y (backwards) and tips a standing body forward (toward -Y);
//   +ry lowers the +X side (so a +X wing goes up with negative ry and a -X wing goes up with positive ry);
//   +rz turns the model counter-clockwise seen from above.
// Location values are in footprint units along the same armature-space axes.
// Scale: "scl" (wave amplitude) and "bias_scl" are unitless factors added to 1; a key may carry a 4th element [sx, sy, sz] (1 = unchanged).
// A "wave" channel is amp x sin(2 pi (cycles x t + phase)) + bias, t = 0..1 across the clip (first and last frame equal, so it loops); "keys" are [frame, [rx, ry, rz], [x, y, z]] poses.
// "rot", "bias_rot" are degrees; "loc", "bias_loc" are footprint units; "cycles" (default 1) is the number of full waves per clip; "phase" is a fraction of a wave (0 to 1).
{
  "$doc": "Rig tables for the two pilot units.",
  // Animation rate shared by all clips. Unit: frames per second. Range: 24 to 60. Source: task brief (30 fps).
  "fps": 30,
  "units": {
    "skai.fledgling": {
      // Weighting: soft nearest-bone. weight = exp(-(d - nearest d) / sigma) with d = (distance to the bone segment - radius) x bias; top max_influences kept, then smoothed over mesh edges.
      // Per bone: "radius" = half thickness of the body part the bone moves. Unit: footprint units. Range: 0 to 0.3. "bias" = distance multiplier, below 1 pulls more vertices to the bone. Unit: factor. Range: 0.5 to 2.
      // sigma: softness of the blend between neighbouring bones. Unit: footprint units. Range: 0.005 to 0.2 (small = hard borders, large = floppy).
      "sigma": 0.045,
      // Most bones that may move one vertex (Unity default allows 4). Unit: count. Range: 1 to 4.
      "max_influences": 4,
      // Lift the root on frames where the deformed mesh would dip below the ground. Unit: boolean. Range: true or false. Used for ground units.
      "ground_clamp": true,
      // Passes of averaging each vertex weight with its edge neighbours (removes tearing at borders). Unit: passes. Range: 0 to 10.
      "smooth_passes": 5,
      "bones": [
        // Ground anchor Unity moves and turns; every other bone hangs below it. No vertices belong to it.
        {"name": "root", "parent": null, "head": [0, 0.08, 0.0], "tail": [0, 0.08, 0.15], "radius": 0.0, "bias": 1.0},
        // Pelvis; legs and spine start here. Head at hip height z = 0.45.
        {"name": "hips", "parent": "root", "head": [0, 0.08, 0.45], "tail": [0, 0.08, 0.56], "radius": 0.25, "bias": 1.0},
        // Torso from hips to the shoulders; its axis sits at y = 0.14, between the chest and the backpack, so both follow it.
        {"name": "spine", "parent": "hips", "head": [0, 0.14, 0.56], "tail": [0, 0.12, 0.86], "radius": 0.21, "bias": 1.0},
        // Skull and beak, tail points along the beak (beak tip is at y = -0.5).
        {"name": "head", "parent": "spine", "head": [0, 0.0, 0.88], "tail": [0, -0.28, 1.02], "radius": 0.14, "bias": 1.0},
        // Model's left arm (+X): shoulder to elbow.
        {"name": "arm_l_upper", "parent": "spine", "head": [0.28, 0.03, 0.78], "tail": [0.36, 0.03, 0.55], "radius": 0.08, "bias": 1.0},
