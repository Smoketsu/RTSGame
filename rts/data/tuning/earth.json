// earth.json: Earth faction Tailoring prototype, Recasting and Attunement (Phase 4). Read by the Earth Tailoring simulation system. Part of rts/data/tuning; loaded by the data loader (rts/src/Sim/Data) at match start. Every value is a starting value for playtesting from the Game Design Proposal (26 Oct 2026).
{
  "$schema_version": 1,
  "$doc": "Recasting and Attunement values for the Earth Tailoring prototype (Phase 4) that the Earth Tailoring simulation reads at match start.",
  // Time a Recasting takes to complete. Unit: seconds. Range: 1 to 60. Source: Factions / Earth / Recasting.
  "recasting_seconds": 15,
  // Share of the unit's cost paid to Recast. Unit: fraction of cost (0.25 = 25%). Range: 0 to 1. Source: Factions / Earth / Recasting.
  "recasting_cost_fraction": 0.25,
  // Resistance to a damage type gained each time the unit is hit by that type. Unit: fraction of incoming damage of that type resisted, per hit (0.01 = 1%). Range: 0 to 0.1. Source: Factions / Earth / Attunement.
  "attunement_gain_per_hit": 0.01,
  // Maximum resistance Attunement can reach against one damage type. Unit: fraction of incoming damage resisted (0.30 = 30%). Range: 0 to 1. Source: Factions / Earth / Attunement.
  "attunement_cap": 0.30,
  // Resistance lost at each fade step while out of combat. Unit: fraction of incoming damage resisted (0.05 = 5 percentage points). Range: 0 to 0.3. Source: Factions / Earth / Attunement.
  "attunement_fade_fraction": 0.05,
  // Time between Attunement fade steps. Unit: seconds. Range: 1 to 60. Source: Factions / Earth / Attunement.
  "attunement_fade_interval_seconds": 10
}
