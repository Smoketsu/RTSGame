// harness.json: Balance harness run sizes and hard limits. Read by the balance harness. Part of rts/data/tuning; loaded by the data loader (rts/src/Sim/Data) at match start. Every value is a starting value for playtesting from the Game Design Proposal (26 Oct 2026).
{
  "$schema_version": 1,
  "$doc": "Balance harness run sizes and the hard limits it checks for match length and HQ survivability.",
  // Number of simulated games run for each matchup on each map. Unit: games per matchup per map (count). Range: 50 to 5000. Source: Matchups and balance / Balance philosophy.
  "games_per_matchup_per_map": 500,
  // Maximum allowed median match length for water versus earth. Unit: seconds. Range: 600 to 1800. Source: Balance philosophy.
  "water_vs_earth_median_max_seconds": 1500,
  // Minimum HQ survival time the harness checks. Same check as hq.json. Unit: seconds. Range: 5 to 120. Source: Balance philosophy.
  "hq_floor_seconds": 20,
  // Supply value of the army the harness uses for the HQ floor check. Same check as hq.json. Unit: supply. Range: 1 to 200. Source: Balance philosophy.
  "hq_floor_supply": 30
}
