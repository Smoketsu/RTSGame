  "weapon": {
    // Damage per hit before the damage table. Unit: health points. Range: 0.01 to 100000. Source: placeholder.
    "damage": 8,
    // Damage type, a key of the damage table. Unit: damage type name. Range: "kinetic", "blast" or "drench" (names in tuning/combat.json). Source: placeholder.
    "damage_type": "kinetic",
    // Reach between unit edges (centre distance minus both radii); 1.5 or less counts as melee. Unit: tiles. Range: 0.1 to 64. Source: Factions / Skai Riders / Unit concepts (core ranged unit); placeholder.
    "range_tiles": 6,
    // Time between two hits. Unit: seconds. Range: 0.05 to 60. Source: placeholder.
    "cooldown_seconds": 1.0,
    // Movement layers of targets the weapon may hit. Unit: list of layer names. Range: 1 to 3 distinct entries of "ground", "water", "air". Source: placeholder.
    "can_target": ["ground", "water", "air"]
  }
}
