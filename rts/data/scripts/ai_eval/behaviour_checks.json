// rts/data/scripts/ai_eval/behaviour_checks.json: the behaviour checks of the balance harness (--behaviour); spec rts/docs/specs/balance_measurement.md M.4 and M.6. Read by rts/tools/BalanceHarness/BehaviourSettings.cs only; it lives under scripts/ so DataLoader skips it (outside the content digest) and in a subfolder so CI does not run it as a command script. Every number is a placeholder.
{
  "$schema_version": 1,
  "$doc": "Behaviour checks: named predicates over one slot's game summary, evaluated for every slot-game of a profile and reported as counts. A check is declared here by its registry ID (BehaviourChecks.cs) under checks.",
  // Games per (map, matchup) cell of a --behaviour run, in the paired layout (72 games over three matchups, about 16 minutes at 4 jobs). Unit: games. Range: 4 to 1000, a multiple of 4. Source: balance_measurement.md M.6; placeholder.
  "games_per_cell": 24,
  // Weight of one rare resource unit against one common unit when a check adds the two. Unit: ratio. Range: 0 to 20, at most 4 decimals. Source: balance_measurement.md M.6 (as counter_rare_cost_weight); placeholder.
  "rare_weight": 1,
  "checks": {
    "static_defence_share": {
      // Run this check. Unit: boolean. Range: true or false. Source: balance_measurement.md M.6; placeholder.
      "enabled": true,
      // Most a slot-game may spend on static defence, as a share of everything it spent (common plus rare_weight times rare); edge inclusive. Unit: fraction. Range: 0 to 1, at most 4 decimals. Source: balance_measurement.md M.4.3 and P-006 (tower spending stays under its budget share); placeholder until package B sets the defence band.
      "max_share": 0.15,
      // Share of judged slot-games that may violate before the check fails for the profile. Unit: fraction. Range: 0 to 1, at most 4 decimals. Source: balance_measurement.md M.6; placeholder.
      "max_violation_fraction": 0.05
    },
    "hq_move_new_income": {
      // Run this check. Unit: boolean. Range: true or false. Source: balance_measurement.md M.6; placeholder.
      "enabled": true,
      // HQ moves shorter than this are ignored (a shuffle is not a relocation). Unit: tiles. Range: 0 to 200. Source: balance_measurement.md M.4.4; placeholder.
      "min_distance_tiles": 4,
      // Number of income buckets summed before the uproot and after the settling time. Unit: buckets. Range: 1 to 20. Source: balance_measurement.md M.4.4; placeholder.
      "window_buckets": 2,
      // Buckets after the HQ roots that are skipped before the after window starts. Unit: buckets. Range: 0 to 20. Source: balance_measurement.md M.4.4; placeholder.
      "settle_buckets": 1,
      // Income after the move must be at least before times (1 + this); below it the move violates (edge inclusive). Unit: fraction. Range: 0 to 10, at most 4 decimals. Source: balance_measurement.md M.4.4 and P-006 (no HQ move without new income); placeholder.
      "min_gain_fraction": 0.10,
      // Share of judged slot-games that may violate before the check fails for the profile. Unit: fraction. Range: 0 to 1, at most 4 decimals. Source: balance_measurement.md M.6; placeholder.
      "max_violation_fraction": 0
    },
    "workers_at": {
      // Run this check. Unit: boolean. Range: true or false. Source: specs/ai_budget_queues.md B.4.1.
      "enabled": true,
      // Second of the bank snapshot at which own workers are counted. Unit: seconds. Range: one of summary_bank_times_seconds in ai_eval.json. Source: specs/ai_budget_queues.md B.4.1 (bar BB-3 compares the printed medians).
      "at_seconds": 300,
      // Fewest workers that hold. Unit: workers. Range: 0 to 200. Source: specs/ai_budget_queues.md B.4.1 (0: always holds; the bar is on the median).
      "min_workers": 0,
      // Share of judged slot-games that may violate before the check fails for the profile. Unit: fraction. Range: 0 to 1, at most 4 decimals. Source: specs/ai_budget_queues.md B.4.1.
      "max_violation_fraction": 0
    },
    "first_drop_off": {
      // Run this check. Unit: boolean. Range: true or false. Source: specs/ai_budget_queues.md B.4.1.
      "enabled": true,
      // Latest second at which the first own non-HQ drop-off may complete. Unit: seconds. Range: 0 to 7200. Source: specs/ai_budget_queues.md B.4.1 (7200: always holds; bar BB-4 compares the printed medians).
      "max_seconds": 7200,
      // Share of judged slot-games that may violate before the check fails for the profile. Unit: fraction. Range: 0 to 1, at most 4 decimals. Source: specs/ai_budget_queues.md B.4.1.
      "max_violation_fraction": 0
    },
    "income_by": {
      // Run this check. Unit: boolean. Range: true or false. Source: rts/docs/specs/ai_economy_calc.md 3.1; placeholder.
      "enabled": true,
      // Second up to which the income (common plus rare_weight x rare deposited) is summed; only whole buckets count. Unit: seconds. Range: 1 to 7200, a multiple of summary_bucket_seconds. Source: rts/docs/specs/ai_economy_calc.md 3.1 (bar EB-3); placeholder.
      "at_seconds": 300,
      // Least income that holds. Unit: resource units. Range: 0 to 1000000. Source: rts/docs/specs/ai_economy_calc.md 3.1 (0: always holds; the bar is on the printed medians); placeholder.
      "min_income": 0,
      // Share of judged slot-games that may violate before the check fails for the profile. Unit: fraction. Range: 0 to 1, at most 4 decimals. Source: rts/docs/specs/ai_economy_calc.md 3.1; placeholder.
      "max_violation_fraction": 0,
      // Print one BEHAVIOUR_BY_OPENING line per faction and opening after the check's line. Unit: boolean. Range: true or false. Source: rts/docs/specs/ai_economy_calc.md 3.1 (bar EB-5); placeholder.
      "print_by_opening": true
    },
    "econ_gap": {
      // Run this check. Unit: boolean. Range: true or false. Source: rts/docs/specs/ai_economy_calc.md 3.2; placeholder.
      "enabled": true,
      // Second up to which the model's incomes are compared; only whole buckets count. Unit: seconds. Range: 1 to 7200, a multiple of summary_bucket_seconds. Source: rts/docs/specs/ai_economy_calc.md 3.2 (bar EB-4); placeholder.
      "at_seconds": 300,
      // Smallest worker cap N the search tries (workers the HQ trains up to, training included). Unit: workers. Range: 1 to 200, at most worker_cap_max. Source: rts/docs/specs/ai_economy_calc.md 3.2; placeholder.
      "worker_cap_min": 8,
      // Largest worker cap N the search tries. Unit: workers. Range: 1 to 200. Source: rts/docs/specs/ai_economy_calc.md 3.2; placeholder.
      "worker_cap_max": 40,
      // Step between worker caps. Unit: workers. Range: 1 to 200. Source: rts/docs/specs/ai_economy_calc.md 3.2; placeholder.
      "worker_cap_step": 2,
      // Smallest worker count at which a depot may be ordered. Unit: workers. Range: 1 to 200, at most depot_trigger_max. Source: rts/docs/specs/ai_economy_calc.md 3.2; placeholder.
      "depot_trigger_min": 4,
      // Largest worker count at which a depot may be ordered. Unit: workers. Range: 1 to 200. Source: rts/docs/specs/ai_economy_calc.md 3.2; placeholder.
      "depot_trigger_max": 40,
      // Step between depot triggers. Unit: workers. Range: 1 to 200. Source: rts/docs/specs/ai_economy_calc.md 3.2; placeholder.
      "depot_trigger_step": 2,
      // Most depots in a searched schedule (0 searches workers only). Unit: depots. Range: 0 to 4. Source: rts/docs/specs/ai_economy_calc.md 3.2; placeholder.
      "max_depots": 3,
      // Largest decision gap, 1000 x (OPT - MOD) / OPT, that holds (1000: always holds; the bar is on the printed medians). Unit: permille. Range: 0 to 1000. Source: rts/docs/specs/ai_economy_calc.md 3.2; placeholder.
      "max_gap_permille": 1000,
      // Share of judged slot-games that may violate before the check fails for the profile. Unit: fraction. Range: 0 to 1, at most 4 decimals. Source: rts/docs/specs/ai_economy_calc.md 3.2; placeholder.
      "max_violation_fraction": 0,
      // Print one BEHAVIOUR_BY_OPENING line per faction and opening after the check's line. Unit: boolean. Range: true or false. Source: rts/docs/specs/ai_economy_calc.md 3.2 (the per-opening decision gaps); placeholder.
      "print_by_opening": true
    }
  }
}
