      // Attack only while the tide level is at or below this. Unit: fraction. Range: attack_tide_min to 1. Source: Matchups; placeholder.
      "attack_tide_max": 1,
      // Ignore the tide window at or above this army supply. Unit: supply. Range: 1 to 400. Source: placeholder.
      "attack_tide_override_supply": 20,
      // Planetary Cycle IDs, most wanted first; the AI picks the first one that may start next when its team holds the Core. Unit: cycle IDs. Range: every cycle in rts/data/cycles exactly once. Source: Win condition and twists / Planetary Cycles; PLACEHOLDER.
      "cycle_preference": ["core_surge", "quake", "windstorm"]
