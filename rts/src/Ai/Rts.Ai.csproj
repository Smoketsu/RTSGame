<!-- rts/src/Ai/Rts.Ai.csproj: the skirmish AI library (assembly Rts.Ai). A host-side player controller that reads public simulation state and submits ordinary commands; it never runs inside Simulation.Step. Targets netstandard2.1 so the same source compiles inside Unity 6 (via Rts.Ai.asmdef) and in the plain .NET test and tool projects. No engine references, no floating point. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- netstandard2.1 is the newest standard Unity 6 fully supports; same as Rts.Sim. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <!-- Assembly and root namespace match the Unity assembly definition name. -->
    <AssemblyName>Rts.Ai</AssemblyName>
    <RootNamespace>Rts.Ai</RootNamespace>
    <!-- No implicit usings: every file lists what it uses, same as inside Unity. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- XML doc generation is off; the documentation standard is enforced by review, not by CS1591. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- Unity package metadata and asmdef files live beside the source but are not compiled. -->
    <None Remove="package.json" />
    <None Remove="Rts.Ai.asmdef" />
    <!-- Unity writes .meta files next to every asset; they are not source. -->
    <Compile Remove="**/*.meta" />
  </ItemGroup>
  <ItemGroup>
    <!-- The AI reads the simulation's public API and builds its command objects. -->
    <ProjectReference Include="../Sim/Rts.Sim.csproj" />
  </ItemGroup>
</Project>
