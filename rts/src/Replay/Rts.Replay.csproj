<!-- rts/src/Replay/Rts.Replay.csproj: the replay library (assembly Rts.Replay). Records the applied command stream of a match, writes and reads the versioned binary replay format (ADR-009) and re-simulates a replay to verify its hashes. Targets netstandard2.1 so the same source compiles inside Unity 6 (via Rts.Replay.asmdef) and in the plain .NET test and tool projects. No engine references, no floating point, no file access. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- netstandard2.1 is the newest standard Unity 6 fully supports; same as Rts.Sim. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <!-- Assembly and root namespace match the Unity assembly definition name. -->
    <AssemblyName>Rts.Replay</AssemblyName>
    <RootNamespace>Rts.Replay</RootNamespace>
    <!-- No implicit usings: every file lists what it uses, same as inside Unity. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- XML doc generation is off; the documentation standard is enforced by review, not by CS1591. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- Unity package metadata and asmdef files live beside the source but are not compiled. -->
    <None Remove="package.json" />
    <None Remove="Rts.Replay.asmdef" />
    <!-- Unity writes .meta files next to every asset; they are not source. -->
    <Compile Remove="**/*.meta" />
  </ItemGroup>
  <ItemGroup>
    <!-- The replay codec reads and builds the simulation's command objects and re-simulates with a Simulation. -->
    <ProjectReference Include="../Sim/Rts.Sim.csproj" />
  </ItemGroup>
</Project>
